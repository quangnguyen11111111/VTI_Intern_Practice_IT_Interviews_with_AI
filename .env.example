NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_practice

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Password reset OTP (use a distinct random value with at least 32 characters)
PASSWORD_RESET_SECRET=replace-with-password-reset-secret-at-least-32-chars

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
