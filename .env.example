NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000/api/v1
# Local development value. Production injects a separately scoped Mongo runtime credential.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_practice
# AI credential is a separate secret; never reuse JWT, SMTP, Mongo, or deploy values.
GEMINI_API_KEY=replace-with-gemini-api-key

# Comma-separated, exact browser origins. Production requires at least one HTTPS origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Parsed request-body limits (1kb..2mb for JSON, 1kb..512kb for forms)
JSON_BODY_LIMIT=256kb
FORM_BODY_LIMIT=64kb
# Number of trusted reverse-proxy hops (0 when directly exposed)
TRUST_PROXY_HOPS=0

# Comma-separated, exact browser origins. Production requires at least one HTTPS origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Parsed request-body limits (1kb..2mb for JSON, 1kb..512kb for forms)
JSON_BODY_LIMIT=256kb
FORM_BODY_LIMIT=64kb
# Number of trusted reverse-proxy hops (0 when directly exposed)
TRUST_PROXY_HOPS=0

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Password reset OTP (use a distinct random value with at least 32 characters)
PASSWORD_RESET_SECRET=replace-with-password-reset-secret-at-least-32-chars

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@example.com

# Migration/index and deploy credentials intentionally have no application variables here.
# Keep them in their protected job/environment only; getEnv() rejects them in production.
# QUO-01 - Daily interview quota
DAILY_INTERVIEW_QUOTA=5
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh

# QUO-01 - Technical rate limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000

RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=600000

RATE_LIMIT_CREATE_INTERVIEW_MAX=10
RATE_LIMIT_CREATE_INTERVIEW_WINDOW_MS=600000

RATE_LIMIT_AI_MAX=5
RATE_LIMIT_AI_WINDOW_MS=60000

RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_SUBMIT_WINDOW_MS=60000

RATE_LIMIT_PROGRESS_MAX=30
RATE_LIMIT_PROGRESS_WINDOW_MS=60000
